# ==============================================================================
# Mobile Web Voice & Text Controller - Environment Configuration
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# Staff Security
STAFF_PIN=1234

# Session & Auto-Return Timing (Seconds)
INACTIVITY_TIMEOUT_SEC=60
WARNING_THRESHOLD_SEC=15
AUTO_RETURN_ENABLED=true
AUTO_RETURN_DELAY_SEC=5
START_BOOTH_ID=start

# Speech-to-Text (STT) Settings: "groq" | "openai" | "faster_whisper"
STT_PROVIDER=groq

# STT API Keys (Required if using groq or openai)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# STT Domain Context / Lexicon Hint (Aligned with LLM intent_node)
STT_INITIAL_PROMPT="บทสนทนาสั่งงานหุ่นยนต์ TurtleBot3 ภาษาไทยผสมอังกฤษ (Code-Switching): จุด A, จุดเอ, A, เอ, จุด B, จุดบี, B, บี, จุด C, จุดซี, C, ซี, กลับจุดเริ่มต้น, กลับ start, จุดเริ่มต้น, start point. Go to point A, point B, point C, return to start."

# ROS 2 Integration Override (Set to true to force Mock mode without ROS 2)
USE_MOCK_ROS2=false

# ROS network profile: local (domain 83 / localhost) or robot (domain 30 / subnet)
# Explicit shell environment overrides .env values; profile supplies defaults.
ROS_PROFILE=local
# Optional workspace setup; default resolves to ../turtlebot-llm/install-colcon/setup.bash
# ROS_WORKSPACE_SETUP=/path/to/install-colcon/setup.bash

# Robot profile requires the actual peer-provided SUPER_CLIENT XML.
# ROS_DISCOVERY_SERVER defaults to 192.168.1.17:11811 in robot profile.
# ROBOT_SUPER_CLIENT_XML=/path/to/super_client.xml
# ROS_DISCOVERY_SERVER=192.168.1.17:11811

# Validity window for backend-owned Return to Start Action goals.
DIRECT_ACTION_VALIDITY_SEC=30.0
