# ==============================================================================
# Mobile Web Voice & Text Controller - Environment Configuration
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# Staff Security
STAFF_PIN=1234
# Optional private SQLite path; default is outside Git under ~/.local/state/turtlebot-dialogue/.
# DIALOGUE_HISTORY_PATH=/absolute/private/path/history.sqlite3

# Session & Auto-Return Timing (Seconds)
INACTIVITY_TIMEOUT_SEC=120
WARNING_THRESHOLD_SEC=15
AUTO_RETURN_ENABLED=true
AUTO_RETURN_DELAY_SEC=5
START_BOOTH_ID=D

# Speech-to-Text (STT) Settings: "groq" | "openai" | "faster_whisper"
STT_PROVIDER=groq
# Input language (ISO 639-1); Thai speech with A/B/C/D station names.
STT_LANGUAGE=th
STT_GROQ_MODEL=whisper-large-v3

# Optional Linux ffmpeg preprocessing; keep off until real-audio comparison passes.
STT_PREPROCESS_AUDIO=false
# Set either filter frequency to 0 to disable that filter; valid range is 0-7999 Hz.
STT_HIGHPASS_FREQ=100
STT_LOWPASS_FREQ=7500
# Dynamic normalization is independent from high/low-pass filtering.
STT_NORMALIZE_AUDIO=false
# Per-request ffmpeg deadline (0 < value <= 30 seconds); timeout falls back to raw audio.
STT_PREPROCESS_TIMEOUT_SEC=8.0

# STT API Keys (Required if using groq or openai)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# STT Domain Context / Lexicon Hint (Aligned with LLM intent_node)
STT_INITIAL_PROMPT="จุด A จุดเอ โซนกู้ภัย RESCUE ZONE SEARCH & RESCUE; จุด B จุดบี โซนการแพทย์ MEDICAL ZONE MEDICAL AID; จุด C จุดซี โซนส่งเสบียง SUPPLY ZONE SUPPLY DROP-OFF; จุด D จุดดี ศูนย์บัญชาการ COMMAND CENTER MISSION CONTROL; กลับจุดเริ่มต้น return to start คือจุด D"

# ROS 2 Integration Override (Set to true to force Mock mode without ROS 2)
USE_MOCK_ROS2=false

# Shared TurtleBot ROS setup supplies network defaults for local (domain 83)
# and robot (domain 30) profiles. Explicit shell environment overrides .env.
ROS_PROFILE=local
# Override only when pointing to an equivalent shared setup script.
# TURTLEBOT_SETUP_SCRIPT=/path/to/turtlebot-llm/setup_demo_auto_ip.sh
# ROS_WORKSPACE_SETUP may name only the install-colcon workspace sourced by that script.

# Robot profile uses the shared setup XML and resolves the robot host dynamically.
# TURTLEBOT_FASTDDS_PROFILE=/path/to/super_client_configuration_file.xml
# TURTLEBOT_ROBOT_HOST=gold-VMware-Virtual-Platform.local
# TURTLEBOT_ROBOT_IP=10.0.0.10  # Optional current IP override when DNS/mDNS is unavailable

# Validity window for backend-owned Return to Start Action goals.
DIRECT_ACTION_VALIDITY_SEC=30.0

# Normal real-ROS launchers enable managed Intent/Subtitle by default.
# Direct uvicorn defaults to unmanaged unless this is true.
# MANAGE_AGENT_NODES=true
# AGENT_WORKSPACE=/home/your-user/ros2_ws/turtlebot-llm
# AGENT_CLOCK_SKEW_SEC=0.6
# Managed nodes read provider keys from AGENT_WORKSPACE/.env, not Backend STT keys.
# Stop/Kill/Manual preferences persist for that workspace across Backend restarts.

# Cloudflare Quick Tunnel & Static QR Automation (Stage 2 Opt-In)
# Enable automatic quick tunnel and KV updates when running launcher
ENABLE_TUNNEL=false
# Static Worker redirect URL (printed on the robot's physical QR code)
WORKER_STATIC_URL=https://robot-link.<your-subdomain>.workers.dev/
# Cloudflare API Token with Workers KV Edit permission (keep private in .env)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_KV_KEY=robot_url
