# ==============================================================================
# Mobile Web Voice & Text Controller - Environment Configuration
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# Staff Security
STAFF_PIN=1234

# Session & Auto-Return Timing (Seconds)
INACTIVITY_TIMEOUT_SEC=120
WARNING_THRESHOLD_SEC=15
AUTO_RETURN_ENABLED=true
AUTO_RETURN_DELAY_SEC=5
START_BOOTH_ID=A

# Speech-to-Text (STT) Settings: "groq" | "openai" | "faster_whisper"
STT_PROVIDER=groq
# Input language (ISO 639-1); Thai speech with A/B/C destination names.
STT_LANGUAGE=th
STT_GROQ_MODEL=whisper-large-v3

# STT API Keys (Required if using groq or openai)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# STT Domain Context / Lexicon Hint (Aligned with LLM intent_node)
STT_INITIAL_PROMPT="บทสนทนาสั่งงานหุ่นยนต์ TurtleBot3 ภาษาไทยผสมอังกฤษ (Code-Switching): จุด A, จุดเอ, A, เอ, จุด B, จุดบี, B, บี, จุด C, จุดซี, C, ซี, กลับจุดเริ่มต้น, กลับ start, จุดเริ่มต้น, start point. Go to point A, point B, point C, return to start."

# ROS 2 Integration Override (Set to true to force Mock mode without ROS 2)
USE_MOCK_ROS2=false

# Shared TurtleBot ROS setup supplies network defaults for local (domain 83)
# and robot (domain 30) profiles. Explicit shell environment overrides .env.
ROS_PROFILE=local
# Override only when pointing to an equivalent shared setup script.
# TURTLEBOT_SETUP_SCRIPT=/path/to/turtlebot-llm/setup_demo_auto_ip.sh
# ROS_WORKSPACE_SETUP may name only the install-colcon workspace sourced by that script.

# Robot profile uses the shared setup XML and resolves the robot host dynamically.
# TURTLEBOT_FASTDDS_PROFILE=/path/to/super_client_configuration_file.xml
# TURTLEBOT_ROBOT_HOST=gold-VMware-Virtual-Platform.local
# TURTLEBOT_ROBOT_IP=10.0.0.10  # Optional current IP override when DNS/mDNS is unavailable

# Validity window for backend-owned Return to Start Action goals.
DIRECT_ACTION_VALIDITY_SEC=30.0
