# ==============================================================================
# Mobile Web Voice & Text Controller - Environment Configuration
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# Staff Security
STAFF_PIN=1234

# Session & Auto-Return Timing (Seconds)
INACTIVITY_TIMEOUT_SEC=60
WARNING_THRESHOLD_SEC=15
AUTO_RETURN_ENABLED=true
AUTO_RETURN_DELAY_SEC=5
START_BOOTH_ID=start

# Speech-to-Text (STT) Settings: "groq" | "openai" | "faster_whisper"
STT_PROVIDER=groq

# STT API Keys (Required if using groq or openai)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# STT Domain Context / Lexicon Hint (Aligned with LLM intent_node)
STT_INITIAL_PROMPT="บทสนทนาสั่งงานหุ่นยนต์ TurtleBot3 ภาษาไทยผสมอังกฤษ (Code-Switching): พาไปบูธ Computer Science, ช่วยพาไปบูธ CS, เดินไป booth 09 วิทยาการคอมพิวเตอร์, พาไปบูธ Mathematics and Statistics, ไปบูธ Math and Stat, booth 10 คณิตศาสตร์และสถิติ, กลับไปที่จุด Start, return to start point, หยุดรอตรงนี้, stop, wait here. Take me to Computer Science booth 09, Mathematics and Statistics booth 10, navigate to CS, go to Math and Stat, return to start."

# ROS 2 Integration Override (Set to true to force Mock mode without ROS 2)
USE_MOCK_ROS2=false
